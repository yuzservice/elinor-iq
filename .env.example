# ELINOR IQ v2 — copy to .env and fill in values.
# Never commit .env.

# --- Application ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- PostgreSQL ---
POSTGRES_DB=elinor_iq
POSTGRES_USER=elinor
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Published HTTP port. The Ubuntu installer sets this to 80.
HTTP_PORT=8080

# --- Elinor Laravel API (read-only) ---
# Optional fallback. Super admin can set these inside Settings instead.
ELINOR_API_BASE_URL=https://api.elinorboutique.com/v1
ELINOR_API_USERNAME=
ELINOR_API_PASSWORD=
ELINOR_RATE_LIMIT_PER_MINUTE=45
ELINOR_SYNC_MAX_REQUESTS=900
ELINOR_SYNC_HOURLY_ONLINE_DETAILS_LIMIT=250
ELINOR_SYNC_HOURLY_POS_DAYS=3
ELINOR_SYNC_INTERVAL_SECONDS=3600

# --- Instagram / Smart Direct ---
# Instagram API with Instagram Login. Do not commit real secrets.
# Tokens are never stored in the database.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v25.0

# If Meta webhooks use a public tunnel hostname, add it here:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-tunnel.example

# --- Frontend ---
VITE_API_BASE_URL=/api
